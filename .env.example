# Copy to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit the real .env file.

# Postgres connection string (Supabase: Project Settings → Database → Connection string → URI).
# On Vercel use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
# Optional: force SSL for non-Supabase hosts (Supabase hosts use SSL automatically)
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Long random string, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# How long an admin stays signed in (hours)
SESSION_HOURS=12

# Public address of the site, used in password-reset and notification email links
SITE_URL=https://your-domain.com

# Official business mailbox used to send notifications and password resets (SMTP)
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USER=notifications@your-domain.com
SMTP_PASS=app-password-here
MAIL_FROM="Parva IT <notifications@your-domain.com>"

# Optional: who every new inquiry is assigned to. Leave empty to use the first Super Admin.
# LEAD_OWNER_EMAIL=owner@your-domain.com

# Optional: website inquiries allowed per visitor IP per 10 minutes (default 5)
# INQUIRY_RATE_LIMIT=5

# Local development only: API port used by the Vite proxy
# API_PORT=3001
