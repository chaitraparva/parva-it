{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "bcryptjs": "^2.4.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.76.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2"
  }
}
