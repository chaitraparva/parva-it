{
  "rewrites": [
    { "source": "/demos/crm/:path*", "destination": "/demos/crm/index.html" },
    { "source": "/demos/hr/:path*", "destination": "/demos/hr/index.html" },
    { "source": "/demos/pms/:path*", "destination": "/demos/pms/index.html" },
    { "source": "/demos/realty/:path*", "destination": "/demos/realty/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
